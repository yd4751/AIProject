/* ============ 基础 ============ */
/* hidden 必须能压过组件自己的 display（如 .lyric-box 的 flex），否则「隐藏」只改了属性、元素仍在屏幕上 */
[hidden] { display: none !important; }

:root {
  --bg: #0d1117;
  --panel: #151b23;
  --panel2: #1c242e;
  --text: #e6edf3;
  --muted: #8b98a9;
  --border: #263140;
  --accent: #4c8dff;
  --accent-2: #7aa7ff;
  --on-accent: #ffffff;
  --stage: #05070a;
  --shadow: 0 10px 30px rgba(0, 0, 0, .35);
  --r: 14px;
  color-scheme: dark;
}

[data-skin="midnight"] { --accent: #4c8dff; --accent-2: #7aa7ff; }
[data-skin="dawn"] {
  --bg: #f2f5fb; --panel: #ffffff; --panel2: #f5f8ff; --text: #1b2434; --muted: #64748b;
  --border: #dfe6f2; --accent: #2563eb; --accent-2: #60a5fa; --on-accent: #fff; --stage: #0a0d12;
  --shadow: 0 10px 28px rgba(23, 43, 77, .10);
  color-scheme: light;
}
[data-skin="aurora"] {
  --bg: #0c1a1c; --panel: #12262a; --panel2: #163035; --text: #dff5ee; --muted: #7fa8a2;
  --border: #1e3d42; --accent: #2fd4a0; --accent-2: #7ef0cd; --on-accent: #04231b; --stage: #04100f;
}
[data-skin="sakura"] {
  --bg: #fdf3f6; --panel: #ffffff; --panel2: #fff6f9; --text: #3a2630; --muted: #8c6d7a;
  --border: #f3dbe4; --accent: #f0568a; --accent-2: #ff9bbc; --on-accent: #fff; --stage: #1a1015;
  color-scheme: light;
}
[data-skin="ocean"] {
  --bg: #061626; --panel: #0c2438; --panel2: #103049; --text: #dcecf8; --muted: #7397b3;
  --border: #173c58; --accent: #2ea8ff; --accent-2: #86d1ff; --on-accent: #00223a; --stage: #02101d;
}
[data-skin="amber"] {
  --bg: #171208; --panel: #221a0e; --panel2: #2c2315; --text: #f7ecd8; --muted: #a8946f;
  --border: #3a2f1c; --accent: #f5a524; --accent-2: #ffd27a; --on-accent: #2a1b00; --stage: #0b0803;
}

* { box-sizing: border-box; }
[hidden] { display: none !important; }

html, body { height: 100%; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font: 14px/1.55 "Segoe UI", "PingFang SC", "Microsoft YaHei", "Hiragino Sans GB", system-ui, sans-serif;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: background .25s, color .25s;
}

.ic { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.ic.big { width: 40px; height: 40px; stroke-width: 1.4; }
svg { flex: none; }

/* ============ 顶栏 ============ */
.topbar {
  height: 60px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 18px;
  gap: 14px;
}
.brand { display: flex; align-items: center; gap: 10px; min-width: 0; }
.brand-ic {
  width: 36px; height: 36px; border-radius: 11px; display: grid; place-items: center;
  background: linear-gradient(155deg, #eef6ff, #cfe3ff);
  box-shadow: inset 0 0 0 1px rgba(120, 170, 255, .35), 0 2px 8px rgba(0, 0, 0, .18);
  flex: none; overflow: hidden;
}
.brand-penguin { width: 30px; height: 30px; display: block; }
.brand-text { font-size: 16.5px; font-weight: 700; letter-spacing: .5px; display: flex; align-items: baseline; gap: 8px; }
.brand-text em { font-style: normal; font-size: 11px; color: var(--muted); letter-spacing: 1.2px; }

.top-actions { display: flex; align-items: center; gap: 10px; position: relative; }

.btn {
  display: inline-flex; align-items: center; gap: 6px;
  height: 34px; padding: 0 13px; border-radius: 9px; cursor: pointer;
  border: 1px solid var(--border); background: var(--panel2); color: var(--text);
  font-size: 13px; font-family: inherit;
  transition: .16s;
}
.btn:hover { border-color: var(--accent); color: var(--accent); }
.btn:active { transform: translateY(1px); }
.btn.ghost { background: transparent; }
.btn.tiny { height: 28px; padding: 0 9px; font-size: 12px; }
.btn .ic { width: 15px; height: 15px; }

/* 换肤：下拉聚合 */
.skin-pick { position: relative; flex: none; }
.skin-dot {
  width: 15px; height: 15px; border-radius: 50%; flex: none;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .22);
}
.skin-cur { font-size: 12.5px; }
.skin-pick .chev { width: 13px; height: 13px; opacity: .55; transition: transform .18s; }
.skin-pick:has(.skin-menu:not([hidden])) .chev { transform: rotate(180deg); }
.skin-menu {
  position: absolute; top: calc(100% + 8px); right: 0; z-index: 42;
  min-width: 168px; padding: 6px;
  background: var(--panel); border: 1px solid var(--border); border-radius: 12px;
  box-shadow: 0 18px 44px rgba(0, 0, 0, .45);
  display: grid; gap: 2px;
}
.skin-item {
  display: flex; align-items: center; gap: 9px; width: 100%;
  padding: 7px 9px; border: 0; border-radius: 8px; cursor: pointer;
  background: transparent; color: var(--text); font: inherit; font-size: 12.5px; text-align: left;
  transition: background .14s;
}
.skin-item:hover { background: var(--panel2); }
.skin-item.active { background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent); }
.skin-swatch {
  width: 20px; height: 20px; border-radius: 50%; flex: none;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .2);
}
.skin-name { flex: 1; min-width: 0; }
.skin-tick { width: 15px; height: 15px; opacity: 0; color: var(--accent); font-size: 11px; }
.skin-item.active .skin-tick { opacity: 1; }
.skin-tick .ic { width: 13px; height: 13px; }

/* ============ 布局：播放区占满，侧栏改为抽屉 ============ */
.layout {
  flex: 1;
  min-height: 0;
  min-width: 0;
  display: block;
  padding: 0 16px 16px;
  transition: padding-right .24s ease;
}
/* 抽屉展开时把舞台让出来，画面不被遮住 */
body.drawer-open .layout { padding-right: 412px; }
.stage-col { min-width: 0; height: 100%; display: flex; flex-direction: column; gap: 12px; min-height: 0; }

/* 顶栏常驻搜索栏 */
.searchbar {
  flex: 1 1 auto; min-width: 0; max-width: 680px;
  display: flex; align-items: center; gap: 8px;
  height: 38px; padding: 0 8px 0 10px;
  background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
  transition: border-color .16s;
}
.searchbar:focus-within { border-color: var(--accent); }
.sbar-ic { width: 15px; height: 15px; color: var(--muted); }
.searchbar input {
  flex: 1; min-width: 0; background: transparent; border: 0; outline: none;
  color: var(--text); font: inherit; font-size: 13px;
}
.searchbar input::placeholder { color: var(--muted); }
.searchbar .btn { height: 26px; flex: none; }

/* 信息 / 列表 / 站点 菜单按钮 */
.nav-group {
  display: flex; gap: 2px; padding: 3px;
  background: var(--panel2); border: 1px solid var(--border); border-radius: 10px;
}
.navbtn {
  display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 11px;
  border: 0; border-radius: 7px; background: transparent; color: var(--muted);
  font: inherit; font-size: 12.5px; cursor: pointer; transition: .15s;
}
.navbtn:hover { color: var(--text); background: color-mix(in srgb, var(--accent) 12%, transparent); }
.navbtn.active { background: var(--accent); color: var(--on-accent); }
.navbtn .ic { width: 15px; height: 15px; }
.navbtn small {
  font-size: 10px; min-width: 15px; padding: 0 4px; line-height: 15px; border-radius: 6px; text-align: center;
  background: color-mix(in srgb, var(--accent) 22%, transparent); color: var(--accent);
}
.navbtn.active small { background: rgba(255, 255, 255, .24); color: var(--on-accent); }

/* ============ 播放器 ============ */
.player {
  position: relative;
  flex: 1;
  min-height: 200px;
  background: var(--stage);
  border: 1px solid var(--border);
  border-radius: var(--r);
  overflow: hidden;
  outline: none;
  user-select: none;
}
.player:fullscreen { border-radius: 0; border: 0; }
.player.audio-mode { background: radial-gradient(120% 90% at 50% 0%, var(--panel2), var(--stage) 70%); }
.player.dragover::after {
  content: ""; position: absolute; inset: 8px; border: 2px dashed var(--accent);
  border-radius: 10px; pointer-events: none;
}

#media { width: 100%; height: 100%; display: block; object-fit: contain; background: var(--stage); }
.player.audio-mode #media { display: none; }

/* 音频模式：黑胶 + 频谱 */
.audio-stage { display: none; position: absolute; inset: 0; }
.player.audio-mode .audio-stage { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px; }
.disc {
  width: min(38%, 240px); aspect-ratio: 1; border-radius: 50%; position: relative;
  background: conic-gradient(from 0deg, #1b1b1f, #34343c, #1b1b1f, #34343c, #1b1b1f);
  box-shadow: 0 12px 40px rgba(0, 0, 0, .55), inset 0 0 0 1px rgba(255, 255, 255, .06);
  display: grid; place-items: center;
  animation: spin 22s linear infinite; animation-play-state: paused;
}
.player.playing .disc { animation-play-state: running; }
@keyframes spin { to { transform: rotate(360deg); } }
.disc img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
.disc-hole {
  position: absolute; width: 15%; aspect-ratio: 1; border-radius: 50%;
  background: var(--stage); box-shadow: inset 0 0 0 6px rgba(255, 255, 255, .07);
}
.audio-title { color: #fff; opacity: .85; font-size: 15px; max-width: 70%; text-align: center; }

.viz { position: absolute; left: 0; right: 0; bottom: 96px; height: 84px; width: 100%; display: none; }
.player.audio-mode .viz { display: block; }

/* 提示层 */
.drop-hint {
  position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 8px; color: #fff; opacity: .55; text-align: center; padding: 20px;
}
.drop-hint p { margin: 0; font-size: 15px; }
.drop-hint small { opacity: .7; font-size: 12px; }
.player.has-media .drop-hint { display: none; }

.center-play {
  position: absolute; inset: 0; display: grid; place-items: center; cursor: pointer;
  background: rgba(0, 0, 0, .28); color: #fff;
}
.center-play .ic { width: 56px; height: 56px; fill: currentColor; stroke: none; filter: drop-shadow(0 4px 14px rgba(0,0,0,.5)); }

.spinner {
  position: absolute; left: 50%; top: 50%; width: 34px; height: 34px; margin: -17px 0 0 -17px;
  border: 3px solid rgba(255, 255, 255, .25); border-top-color: #fff; border-radius: 50%;
  animation: sp .8s linear infinite;
}
@keyframes sp { to { transform: rotate(360deg); } }

.toast {
  position: absolute; left: 50%; top: 16px; transform: translateX(-50%);
  background: rgba(0, 0, 0, .78); color: #fff; padding: 7px 14px; border-radius: 20px;
  font-size: 13px; pointer-events: none; z-index: 9; max-width: 80%;
}

.player-top {
  position: absolute; top: 0; left: 0; right: 0; padding: 14px 16px 26px;
  background: linear-gradient(rgba(0, 0, 0, .6), transparent);
  display: flex; align-items: center; gap: 10px; pointer-events: none;
  opacity: 0; transition: opacity .2s; z-index: 8;
}
.player.show-top .player-top { opacity: 1; }
.pt-title { color: #fff; font-size: 14px; text-shadow: 0 1px 4px rgba(0, 0, 0, .6); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pt-badge {
  margin-left: auto; background: var(--accent); color: var(--on-accent);
  padding: 2px 8px; border-radius: 20px; font-size: 12px; font-weight: 600;
}
/* 在线播放的缓存提示：贴在播放区右上角，不随控制条一起淡出 */
.pt-cache {
  position: absolute; top: 46px; right: 14px; z-index: 9;
  display: flex; align-items: center; gap: 5px;
  padding: 4px 9px; border-radius: 20px;
  background: rgba(8, 12, 18, .62); border: 1px solid rgba(255, 255, 255, .16);
  color: #fff; font-size: 11.5px; font-family: inherit; backdrop-filter: blur(6px);
  pointer-events: none; transition: opacity .25s;
}
.pt-cache .ic { width: 12px; height: 12px; color: var(--accent); flex: none; }
.pt-cache.done { border-color: var(--accent); cursor: pointer; pointer-events: auto; }
.pt-cache.done:hover { background: rgba(8, 12, 18, .85); }
.pt-cache.done.fail { border-color: #f59e0b; color: #fbbf24; }
.pt-cache.done.fail .ic { color: #f59e0b; }
.pt-cache.done .ic { color: var(--accent); }
.pt-cache[hidden] { display: none; }

/* ============ 控制条 ============ */
.controls {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 34px 14px 10px;
  background: linear-gradient(transparent, rgba(0, 0, 0, .78));
  transition: opacity .2s, transform .2s; z-index: 8;
}
.player.idle.playing .controls { opacity: 0; transform: translateY(8px); pointer-events: none; }
.player.idle.playing { cursor: none; }

.pwrap { position: relative; padding: 6px 0 4px; cursor: pointer; }
.ptrack {
  position: relative; height: 5px; border-radius: 4px; background: rgba(255, 255, 255, .22);
  transition: height .12s;
}
.pwrap:hover .ptrack, .player.audio-mode .ptrack { height: 8px; }
.pbuf { position: absolute; inset: 0; border-radius: 4px; overflow: hidden; }
.pbuf i { position: absolute; top: 0; bottom: 0; background: rgba(255, 255, 255, .3); display: block; }
.pplayed {
  position: absolute; left: 0; top: 0; bottom: 0; width: 0;
  background: linear-gradient(90deg, var(--accent-2), var(--accent)); border-radius: 4px;
}
.pknob {
  position: absolute; top: 50%; left: 0; width: 13px; height: 13px; border-radius: 50%;
  background: #fff; transform: translate(-50%, -50%) scale(0); transition: transform .12s;
  box-shadow: 0 2px 6px rgba(0, 0, 0, .5);
}
.pwrap:hover .pknob, .pknob.active { transform: translate(-50%, -50%) scale(1); }

.ptip {
  position: absolute; bottom: 26px; transform: translateX(-50%);
  background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 4px;
  text-align: center; color: var(--text); pointer-events: none; box-shadow: var(--shadow);
}
.ptip canvas { display: block; width: 180px; height: 101px; border-radius: 5px; background: #000; }
.ptip span { display: block; font-size: 11px; padding-top: 3px; font-variant-numeric: tabular-nums; }
.ptip.audio { padding: 6px 10px; }
.ptip.audio canvas { display: none; }
.ptip.audio span { padding: 0; font-size: 12px; }

.bar { display: flex; align-items: center; gap: 6px; padding-top: 4px; }
.bar-left { display: flex; align-items: center; gap: 2px; }
.bar-right { display: flex; align-items: center; gap: 2px; margin-left: auto; }

.cbtn {
  width: 34px; height: 34px; border-radius: 8px; border: 0; cursor: pointer;
  background: transparent; color: #fff; display: grid; place-items: center; transition: .15s;
}
.cbtn:hover { background: rgba(255, 255, 255, .16); }
.cbtn.play { width: 40px; height: 40px; }
.cbtn.text { width: auto; padding: 0 9px; font: 600 12px/1 ui-monospace, Consolas, monospace; white-space: nowrap; }
.cbtn.text em { font-style: normal; opacity: .8; }
.cbtn.on { color: var(--accent-2); }

.time {
  color: #dfe6ef; font-size: 12px; font-variant-numeric: tabular-nums;
  margin-left: 6px; opacity: .9; display: flex; gap: 5px;
}
.time i { font-style: normal; opacity: .5; }

.vol-wrap { display: flex; align-items: center; }
.vol { width: 0; opacity: 0; transition: width .18s, opacity .18s; }
.vol-wrap:hover .vol, .vol:focus { width: 76px; opacity: 1; }
/* 滑杆：--v 为 0~1 的填充比例，由 JS 按值实时写入 */
input[type=range] {
  --v: 0;
  --trk: rgba(255, 255, 255, .28);
  -webkit-appearance: none; appearance: none; height: 4px; border-radius: 3px; cursor: pointer;
  background:
    linear-gradient(to right,
      var(--accent) 0 calc(var(--v) * 100%),
      var(--trk) calc(var(--v) * 100%) 100%);
}
input[type=range]::-webkit-slider-thumb {
  -webkit-appearance: none; width: 12px; height: 12px; border-radius: 50%; background: #fff;
  border: 0; box-shadow: 0 1px 4px rgba(0, 0, 0, .5);
}
/* Firefox */
input[type=range]::-moz-range-track { height: 4px; border-radius: 3px; background: var(--trk); }
input[type=range]::-moz-range-progress { height: 4px; border-radius: 3px; background: var(--accent); }
input[type=range]::-moz-range-thumb { width: 12px; height: 12px; border: 0; border-radius: 50%; background: #fff; }

/* 气泡 */
.pop-host { position: relative; }
.pop {
  position: absolute; bottom: 42px; right: 0; width: 232px; padding: 12px;
  background: var(--panel); border: 1px solid var(--border); border-radius: 12px;
  box-shadow: var(--shadow); color: var(--text);
  opacity: 0; visibility: hidden; transform: translateY(6px); transition: .16s;
}
.pop.open { opacity: 1; visibility: visible; transform: none; }
.pop-title { font-size: 12px; color: var(--muted); margin-bottom: 8px; }
.pop input[type=range] { width: 100%; --trk: var(--border); }
.pop input[type=range]::-webkit-slider-thumb { background: var(--accent); }
.pop input[type=range]::-moz-range-thumb { background: var(--accent); }
.chips { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 10px; }
.chips button {
  border: 1px solid var(--border); background: var(--panel2); color: var(--text);
  border-radius: 7px; padding: 4px 8px; font-size: 12px; cursor: pointer; font-variant-numeric: tabular-nums;
}
.chips button:hover { border-color: var(--accent); }
.chips button.active { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
.switch { display: flex; align-items: center; gap: 7px; margin-top: 10px; font-size: 12px; color: var(--muted); cursor: pointer; }
.switch input { accent-color: var(--accent); }

/* ============ 截图（浮层，非必要信息不常驻） ============ */
.shots {
  position: fixed; left: 16px; bottom: 96px; z-index: 44;
  width: min(560px, 52vw);
  background: color-mix(in srgb, var(--panel) 94%, transparent);
  backdrop-filter: blur(8px);
  border: 1px solid var(--border); border-radius: var(--r);
  padding: 8px 12px 10px; box-shadow: var(--shadow);
}
.shots-head { display: flex; align-items: center; gap: 8px; font-size: 12.5px; margin-bottom: 6px; }
.shots-head small { color: var(--muted); }
.spacer { flex: 1; }
.shots-list { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 4px; }
.shot {
  position: relative; flex: none; border-radius: 8px; overflow: hidden;
  border: 1px solid var(--border); background: var(--panel2);
}
.shot img { display: block; height: 84px; width: 149px; object-fit: cover; }
.shot .shot-acts {
  position: absolute; inset: auto 0 0 0; display: flex; gap: 4px; justify-content: center;
  padding: 5px; background: linear-gradient(transparent, rgba(0, 0, 0, .8));
  opacity: 0; transition: .15s;
}
.shot:hover .shot-acts { opacity: 1; }
.shot button {
  width: 26px; height: 26px; border-radius: 6px; border: 0; cursor: pointer;
  background: rgba(255, 255, 255, .18); color: #fff; display: grid; place-items: center;
}
.shot button:hover { background: var(--accent); }
.shot button .ic { width: 14px; height: 14px; }

/* ============ 抽屉（信息 / 播放列表 / 站点） ============ */
.drawer {
  position: fixed; top: 60px; right: 12px; bottom: 12px; width: 384px; z-index: 45;
  display: flex; flex-direction: column; min-height: 0;
  background: var(--panel); border: 1px solid var(--border); border-radius: var(--r);
  box-shadow: 0 20px 50px rgba(0, 0, 0, .42);
  transform: translateX(calc(100% + 24px)); opacity: 0; pointer-events: none;
  transition: transform .24s ease, opacity .2s ease;
}
.drawer.open { transform: none; opacity: 1; pointer-events: auto; }
.drawer-head {
  flex: none; display: flex; align-items: center; gap: 8px;
  padding: 9px 10px 9px 14px; border-bottom: 1px solid var(--border);
  font-size: 13px; font-weight: 600;
}
.drawer-head .ic { width: 15px; height: 15px; color: var(--accent); }

.panel { display: none; flex: 1; min-height: 0; overflow-y: auto; padding: 12px; }
.panel.active { display: block; }

/* 豆瓣卡片 */
.douban-search {
  display: flex; align-items: center; gap: 8px; margin-bottom: 12px;
  position: relative; background: var(--panel2); border: 1px solid var(--border);
  border-radius: 10px; padding: 0 8px 0 10px; height: 36px;
}
.douban-search input {
  flex: 1; min-width: 0; background: transparent; border: 0; outline: none;
  color: var(--text); font-size: 13px; font-family: inherit;
}
.douban-search .btn { height: 26px; }

/* 搜索栏里的分类下拉：同时决定检索类型和参与检索的站点 */
.db-kind-sel {
  flex: none; height: 24px; padding: 0 4px; cursor: pointer;
  background: var(--panel2); color: var(--muted);
  border: 1px solid var(--border); border-radius: 7px;
  font-size: 12px; font-family: inherit; outline: none;
}
.db-kind-sel:hover { color: var(--text); border-color: var(--accent); }

/* 信息页内部的子页：豆瓣信息 / 站点资源 */
.subtabs {
  display: flex; gap: 4px; margin: 0 0 10px; padding: 3px;
  background: var(--panel2); border: 1px solid var(--border); border-radius: 10px;
}
.subtab {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 5px;
  border: 0; background: transparent; color: var(--muted); cursor: pointer;
  border-radius: 7px; height: 28px; padding: 0 8px;
  font-size: 12.5px; font-family: inherit; transition: .15s;
}
.subtab:hover { color: var(--text); }
.subtab.active { background: var(--accent); color: var(--on-accent); }
.subtab .ic { width: 14px; height: 14px; }
.subtab small {
  font-size: 10.5px; min-width: 16px; padding: 0 4px; border-radius: 999px;
  background: rgba(127, 127, 127, .28); line-height: 16px;
}
.subpanel { display: none; }
.subpanel.active { display: block; }

/* 候选区默认折叠，只占一行 */
.cands-fold { margin-top: 10px; border-top: 1px solid var(--border); padding-top: 8px; }
.cands-fold > summary {
  cursor: pointer; font-size: 12.5px; color: var(--muted);
  list-style: none; display: flex; align-items: center; gap: 8px;
}
.cands-fold > summary::-webkit-details-marker { display: none; }
.cands-fold > summary::before { content: '▸'; font-size: 10px; transition: transform .15s; }
.cands-fold[open] > summary::before { transform: rotate(90deg); }
.cands-fold > summary:hover { color: var(--accent); }
.fold-preview {
  flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-size: 11px; opacity: .7;
}
.sites-empty { color: var(--muted); font-size: 12.5px; padding: 18px 10px; text-align: center; }
.sites-manage { margin-top: 12px; border-top: 1px solid var(--border); padding-top: 10px; }
.sites-manage > summary {
  cursor: pointer; display: flex; align-items: center; gap: 6px;
  font-size: 12.5px; color: var(--muted); list-style: none;
}
.sites-manage > summary::-webkit-details-marker { display: none; }
.sites-manage > summary:hover { color: var(--accent); }
.sites-manage > summary .ic { width: 14px; height: 14px; }

/* 豆瓣最佳匹配角标 */
.db-best {
  display: inline-block; margin: 0 0 8px; padding: 2px 8px; border-radius: 999px;
  font-size: 11px; color: var(--accent); background: color-mix(in srgb, var(--accent) 16%, transparent);
  border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
}

/* 豆瓣检索类型：全部 / 影视 / 音乐 */
.db-seg { display: flex; align-items: center; gap: 6px; margin: 0 0 10px; }
.seg-btn {
  flex: none; white-space: nowrap;
  border: 1px solid var(--border); background: var(--panel2); color: var(--muted);
  border-radius: 999px; padding: 3px 12px; font-size: 12px; cursor: pointer; font-family: inherit;
  transition: .15s;
}
.seg-btn:hover { color: var(--text); border-color: var(--accent); }
.seg-btn.active { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
.seg-hint { margin-left: auto; min-width: 0; flex: 1; text-align: right; font-size: 11px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 候选条目上的类型标签 */
.tag {
  display: inline-block; margin-left: 6px; padding: 1px 6px; border-radius: 6px;
  font-size: 11px; line-height: 1.5; vertical-align: 1px; white-space: nowrap;
}
.tag.movie { color: #6aa9ff; background: rgba(76, 141, 255, .16); }
.tag.music { color: #ff8fb4; background: rgba(240, 86, 138, .16); }
.cand-group { font-size: 12px; color: var(--muted); margin: 10px 0 6px; display: flex; align-items: center; gap: 6px; }
.cand-group::after { content: ''; flex: 1; height: 1px; background: var(--border); }

.db-card { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-bottom: 12px; }
.db-head { display: flex; gap: 12px; padding: 12px; background: var(--panel2); }
.db-cover {
  width: 92px; height: 130px; flex: none; border-radius: 8px; overflow: hidden;
  background: var(--bg); display: grid; place-items: center; color: var(--muted); font-size: 11px;
  border: 1px solid var(--border);
}
.db-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
.db-meta { min-width: 0; flex: 1; }
.db-meta h3 { margin: 2px 0 4px; font-size: 16px; line-height: 1.35; }
.db-sub { color: var(--muted); font-size: 12px; }
.db-rate { display: flex; align-items: center; gap: 6px; margin-top: 8px; }
.stars { color: #f5a524; letter-spacing: 1px; font-size: 13px; }
.stars .off { color: var(--border); }
.db-rate b { color: #f5a524; font-size: 18px; line-height: 1; }
.db-rate small { color: var(--muted); font-size: 11px; }

.db-rows { padding: 10px 12px; display: grid; gap: 6px; border-top: 1px solid var(--border); }
.db-row { display: flex; gap: 8px; font-size: 12.5px; }
.db-row span { color: var(--muted); flex: none; width: 42px; }
.db-row div { min-width: 0; }
.db-intro {
  margin: 0; padding: 10px 12px; border-top: 1px solid var(--border);
  font-size: 12.5px; color: var(--muted); line-height: 1.7;
  max-height: 92px; overflow: auto; white-space: pre-wrap;
}
.db-actions { display: flex; gap: 8px; padding: 0 12px 12px; }
.db-actions a { text-decoration: none; }

.db-cands { display: grid; gap: 6px; }
.cand {
  display: flex; align-items: center; gap: 10px; padding: 6px; border-radius: 9px;
  border: 1px solid transparent; cursor: pointer; text-align: left; width: 100%;
  background: var(--panel2); color: var(--text); font-family: inherit;
}
.cand:hover { border-color: var(--accent); }
.cand img { width: 32px; height: 45px; object-fit: cover; border-radius: 4px; flex: none; background: var(--bg); }
.cand img:not([src]) { background: linear-gradient(135deg, var(--panel2), var(--bg)); box-shadow: inset 0 0 0 1px var(--border); }
.cand .cand-t { font-size: 13px; }
.cand .cand-s { font-size: 11px; color: var(--muted); }

.empty { color: var(--muted); font-size: 12.5px; text-align: center; padding: 26px 10px; line-height: 1.8; }

/* 播放列表 */
.panel-head { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; font-size: 12px; color: var(--muted); }
.panel-head .btn { margin-left: auto; }
.plist { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
.plist li {
  display: flex; align-items: center; gap: 8px; padding: 7px 9px; border-radius: 8px;
  cursor: pointer; font-size: 12.5px; background: var(--panel2); border: 1px solid transparent;
}
.plist li:hover { border-color: var(--accent); }
.plist li.cur { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, var(--panel2)); }
.plist li .ic { width: 15px; height: 15px; color: var(--muted); }
.plist li .nm { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.plist li .tag { font-size: 10.5px; color: var(--muted); flex: none; }
.plist li .del {
  width: 22px; height: 22px; border: 0; border-radius: 6px; background: transparent;
  color: var(--muted); cursor: pointer; display: grid; place-items: center;
}
.plist li .del:hover { background: #ef4444; color: #fff; }
/* 「存到本机」：把本地文件下载到当前设备（手机浏览器会存进系统下载目录） */
.plist li .savebtn {
  width: 22px; height: 22px; border: 0; border-radius: 6px; background: transparent;
  color: var(--muted); cursor: pointer; display: grid; place-items: center; flex: none;
}
.plist li .savebtn:hover { background: var(--accent); color: var(--on-accent); }

/* 条目内的下载进度（下载中的条目才出现） */
.plist li.has-dl { flex-wrap: wrap; }
.plist li .pl-main { display: flex; align-items: center; gap: 8px; width: 100%; min-width: 0; }
.plist li .pl-dl { width: 100%; display: flex; align-items: center; gap: 7px; margin-top: 1px; }
.plist li .pl-dl[hidden] { display: none; }
.plist li .pl-track { flex: 1; height: 3px; border-radius: 3px; background: var(--border); overflow: hidden; }
.plist li .pl-track i { display: block; height: 100%; width: 0; background: var(--accent); border-radius: 3px; transition: width .25s; }
.plist li .pl-pct { font-size: 10.5px; color: var(--accent); flex: none; font-variant-numeric: tabular-nums; }
.plist li.dl-err .pl-track i { background: #ff7b7b; }
.plist li.dl-err .pl-pct { color: #ff7b7b; }

/* 历史记录、本地资源标记和歌词标记 */
.plist li.history { border-left: 3px solid var(--accent-2); }
.plist li .status {
  width: 14px; height: 14px; border-radius: 50%; margin-right: 4px;
  background: var(--border); color: var(--muted);
  display: flex; align-items: center; justify-content: center;
  font-size: 10px;
}
.plist li .status.local { background: #4ade80; color: #fff; }
.plist li .status.remote { background: #60a5fa; color: #fff; }
.plist li .status.has-lyric::after {
  content: "♪";
  font-size: 10px;
  margin-left: 1px;
}

/* 帮助 */
.help { flex: none; border-top: 1px solid var(--border); padding: 10px 12px; font-size: 12px; }
.help summary { cursor: pointer; color: var(--muted); display: flex; align-items: center; gap: 6px; }
.help summary .ic { width: 14px; height: 14px; }
.help-body { padding-top: 10px; }
.keys { list-style: none; margin: 0 0 10px; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 4px 8px; }
.keys li { color: var(--muted); display: flex; align-items: center; gap: 4px; }
kbd {
  background: var(--panel2); border: 1px solid var(--border); border-bottom-width: 2px;
  border-radius: 4px; padding: 0 5px; font: 11px/1.6 ui-monospace, Consolas, monospace; color: var(--text);
}
.fmt-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 3px 8px; color: var(--muted); font-size: 11.5px; }
.fmt-list b { color: var(--text); font-weight: 500; }
.dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 5px; }
.dot.y { background: #22c55e; }
.dot.p { background: #f59e0b; }
.dot.n { background: #ef4444; }

/* ============ 可配置抓取站点 ============ */
.site-row { display: flex; flex-wrap: wrap; gap: 5px; margin: 0 0 10px; }
.site-chip {
  display: inline-flex; align-items: center; gap: 5px; cursor: pointer;
  border: 1px solid var(--border); background: var(--panel2); color: var(--muted);
  border-radius: 999px; padding: 3px 10px; font-size: 12px; transition: .15s;
}
.site-chip:hover { border-color: var(--accent); color: var(--text); }
.site-chip.on { background: color-mix(in srgb, var(--accent) 16%, transparent); border-color: var(--accent); color: var(--text); }
.site-chip .ly { font-size: 10px; padding: 0 4px; border-radius: 4px; background: rgba(240, 86, 138, .18); color: #ff8fb4; }
.site-chip.busy { opacity: .6; }

.site-list { list-style: none; margin: 0 0 10px; padding: 0; }


.site-list li {
  display: flex; align-items: center; gap: 8px; padding: 7px 8px; margin-bottom: 5px;
  border: 1px solid var(--border); border-radius: 9px; background: var(--panel2);
}
.site-list .sn { font-size: 13px; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.site-list .sm { font-size: 11px; color: var(--muted); }
.site-list li.off .sn { opacity: .5; }
.sbtn {
  flex: none; border: 1px solid var(--border); background: transparent; color: var(--muted);
  border-radius: 6px; height: 22px; padding: 0 7px; font-size: 11px; cursor: pointer; font-family: inherit;
}
.sbtn:hover { color: var(--accent); border-color: var(--accent); }
.sbtn.del:hover { color: #ef4444; border-color: #ef4444; }
.switch.site-auto { margin: 0 0 10px; font-size: 12px; }

.site-form { border: 1px solid var(--border); border-radius: 10px; padding: 10px; background: var(--panel2); margin-bottom: 10px; }
.sf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px; }
.sf-grid label { display: flex; flex-direction: column; gap: 4px; font-size: 11px; color: var(--muted); }
.sf-grid label.wide { grid-column: 1 / -1; }
.sf-grid input, .sf-grid select {
  background: var(--panel); border: 1px solid var(--border); border-radius: 7px;
  color: var(--text); font: 12px/1.5 inherit; padding: 5px 8px; outline: none; width: 100%;
}
.sf-grid input:focus, .sf-grid select:focus { border-color: var(--accent); }
.form-actions { display: flex; gap: 6px; margin-top: 8px; }
.site-tip { margin: 8px 0 0; font-size: 11px; color: var(--muted); line-height: 1.6; }
.site-tip code { background: var(--panel); border: 1px solid var(--border); border-radius: 4px; padding: 0 4px; }

/* ============ 歌词 ============ */
/* 铺满整个播放区域：不再是一条贴在底部的窄条，背景做成轻遮罩让歌词成为主角 */
.lyric-box {
  position: absolute; inset: 0; z-index: 6;
  display: flex; flex-direction: column; padding: 46px 0 78px;
  background: linear-gradient(to bottom, rgba(8, 12, 18, .62), rgba(8, 12, 18, .82));
  backdrop-filter: blur(10px);
  pointer-events: auto;
}
/* 头部栏（歌词来源 + 本地/抓歌词/保存/关闭）播放时一律不出现，只在暂停时淡入
   播放中鼠标划过歌词区也不再浮出，避免挡住歌词和画面 */
.lyric-head {
  position: absolute; bottom: 86px; left: 16px; right: 16px; z-index: 2; margin: 0;
  display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--muted);
  opacity: 0; transition: opacity .22s; pointer-events: none;
}
.player:not(.playing) .lyric-head { opacity: .9; pointer-events: auto; }
.player.lyric-on .audio-stage { opacity: 0; transition: opacity .3s; }
.lyric-head .ic { width: 13px; height: 13px; }
.lyric-src { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lyric-head .spacer { flex: 1; }
.lbtn {
  flex: none; border: 1px solid var(--border); background: transparent; color: var(--muted);
  border-radius: 6px; height: 21px; padding: 0 7px; font-size: 11px; cursor: pointer; font-family: inherit;
}
.lbtn:hover { color: var(--accent); border-color: var(--accent); }
.lbtn .ic { width: 12px; height: 12px; }
.lbtn.on { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }

.lyric-scroll { position: relative; flex: 1; overflow: hidden; padding: 0 8%; mask-image: linear-gradient(to bottom, transparent, #000 16%, #000 84%, transparent); }
.lyric-inner { transition: transform .45s cubic-bezier(.22, .61, .36, 1); padding: 12px 0; }
.lyric-line {
  padding: 7px 12px; border-radius: 8px; font-size: 16px; line-height: 1.6; text-align: center;
  color: rgba(255, 255, 255, .5); cursor: pointer; transition: color .25s, background .25s, transform .25s;
  text-shadow: 0 1px 6px rgba(0, 0, 0, .55);
}
.lyric-line:hover { background: rgba(255, 255, 255, .10); color: #fff; }
.lyric-line.on { color: #fff; font-size: 20px; font-weight: 600; transform: scale(1.02); }
[data-skin="dawn"] .lyric-line, [data-skin="sakura"] .lyric-line { color: rgba(0, 0, 0, .55); text-shadow: 0 1px 6px rgba(255, 255, 255, .6); }
[data-skin="dawn"] .lyric-line.on, [data-skin="sakura"] .lyric-line.on { color: var(--accent); }
.lyric-empty { text-align: center; color: rgba(255, 255, 255, .6); font-size: 12px; padding: 10px; }

/* 滚动条 */
::-webkit-scrollbar { width: 9px; height: 9px; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 6px; }
::-webkit-scrollbar-thumb:hover { background: var(--muted); }
::-webkit-scrollbar-track { background: transparent; }

@media (max-width: 1180px) {
  .brand-text em { display: none; }
  .searchbar { max-width: none; }
}
/* 窄屏：抽屉改为底部浮层，不再挤压播放区 */
@media (max-width: 980px) {
  body.drawer-open .layout { padding-right: 16px; }
  .drawer {
    top: auto; left: 8px; right: 8px; bottom: 8px; width: auto;
    height: min(74vh, 540px);
    transform: translateY(calc(100% + 24px));
  }
  .drawer.open { transform: none; }
  .shots { width: min(560px, 76vw); left: 12px; bottom: 88px; }
}
@media (max-width: 760px) {
  .brand-text { display: none; }
  .skin-cur { display: none; }
  .navbtn span { display: none; }
  .navbtn { padding: 0 9px; }
}

/* ---------------- 站点人机验证码弹层 ---------------- */
.cap-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(4, 8, 14, .55); backdrop-filter: blur(3px);
  display: grid; place-items: center;
}
.cap-pop {
  width: min(320px, 92vw); padding: 14px 16px 16px;
  background: var(--panel); border: 1px solid var(--border);
  border-radius: 14px; box-shadow: 0 18px 48px rgba(0, 0, 0, .4);
}
.cap-head {
  display: flex; align-items: center; gap: 7px;
  font-size: 13.5px; font-weight: 600; color: var(--text); margin-bottom: 6px;
}
.cap-head .ic { width: 15px; height: 15px; color: var(--accent); }
.cap-head .lbtn { margin-left: auto; }
.cap-tip { margin: 0 0 10px; font-size: 11.5px; color: var(--muted); line-height: 1.5; }
.cap-img-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.cap-img-row img {
  height: 44px; min-width: 120px; border-radius: 8px;
  border: 1px solid var(--border); background: #fff; object-fit: contain;
}
.cap-input {
  width: 100%; box-sizing: border-box; padding: 8px 10px; margin-bottom: 10px;
  border: 1px solid var(--border); border-radius: 8px;
  background: var(--panel2); color: var(--text); font: inherit; font-size: 14px;
  letter-spacing: 2px;
}
.cap-input:focus { outline: none; border-color: var(--accent); }
.cap-actions { display: flex; gap: 8px; justify-content: flex-end; }

/* ==================== 手机端适配 ==================== */
/* 触屏基础：禁掉双击缩放带来的误触、去掉点击高亮、避免下拉刷新把播放页拉走 */
html { -webkit-text-size-adjust: 100%; }
body { overscroll-behavior: none; }
button, .cand, .skin-item, .navbtn { -webkit-tap-highlight-color: transparent; }

/* 触屏设备：依赖 hover 才出现的东西改成常显（歌词工具栏仍然只在暂停时出现） */
@media (hover: none), (pointer: coarse) {
  .lyric-head .lbtn { height: 26px; padding: 0 9px; font-size: 11.5px; }
  .lyric-box { padding: 40px 0 104px; }
  .lyric-head { bottom: 112px; }
  .lyric-line { font-size: 17px; }
  .lyric-line.on { font-size: 21px; }
  .shot .shot-acts { opacity: 1; }
  .player { touch-action: manipulation; }
  .pwrap { padding: 12px 0 10px; }
  .pwrap .pknob { transform: translate(-50%, -50%) scale(1); }
  .vol-wrap .vol { display: none; }
}

/* 手机竖屏：顶栏折成两行（品牌+操作 / 整行搜索），抽屉改整屏底部弹层 */
@media (max-width: 640px) {
  body { height: 100%; height: 100dvh; }

  .topbar {
    height: auto; flex-wrap: wrap; gap: 8px;
    padding: calc(6px + env(safe-area-inset-top, 0px)) 12px 8px;
  }
  .brand { order: 1; gap: 8px; }
  .brand-ic { width: 32px; height: 32px; border-radius: 10px; }
  .brand-penguin { width: 26px; height: 26px; }
  .brand-text { display: flex; font-size: 15px; }
  .brand-text em { display: none; }

  .top-actions { order: 2; margin-left: auto; gap: 6px; }
  .nav-group { padding: 2px; }
  .navbtn { height: 32px; padding: 0 8px; }
  .navbtn .ic { width: 17px; height: 17px; }
  /* 资源导入只留图标（文案是文本节点，用 font-size:0 收起来） */
  #btnImport { width: 36px; padding: 0; justify-content: center; font-size: 0; gap: 0; }
  #btnImport .ic { width: 18px; height: 18px; }
  #skinBtn { height: 34px; padding: 0 9px; }
  .skin-cur { display: none; }

  .searchbar {
    order: 3; flex: 1 0 100%; height: 42px; gap: 6px; padding: 0 6px 0 10px;
  }
  .searchbar input { font-size: 16px; }   /* 16px 起 iOS 聚焦时不会自动放大页面 */
  .searchbar .btn { height: 32px; padding: 0 12px; font-size: 13px; }
  .db-kind-sel { height: 28px; font-size: 13px; }

  .layout { padding: 0 8px calc(8px + env(safe-area-inset-bottom, 0px)); }
  body.drawer-open .layout { padding-right: 8px; }
  .player { border-radius: 12px; }

  /* 控制条：只留必要按钮，按钮放大到拇指友好尺寸 */
  .controls { padding: 24px 8px 6px; }
  .pwrap { padding: 8px 0; }
  .ptrack { height: 6px; }
  .pknob { width: 14px; height: 14px; }
  .bar { gap: 2px; }
  .cbtn { width: 40px; height: 40px; }
  .cbtn.play { width: 46px; height: 46px; }
  .cbtn.play .ic { width: 22px; height: 22px; }
  .cbtn.text { padding: 0 6px; }
  .vol-wrap, #btnShot, #btnPip { display: none; }
  .time { margin-left: 2px; font-size: 11px; gap: 3px; }
  .player-top { padding: 10px 12px 20px; }
  .pt-title { font-size: 13px; }
  .pop { right: -6px; width: min(268px, calc(100vw - 24px)); }
  .toast { top: 10px; font-size: 12.5px; padding: 6px 12px; max-width: 88%; }

  /* 抽屉：整屏底部弹层，带圆角，避开home指示条 */
  .drawer {
    top: auto; left: 0; right: 0; bottom: 0; width: auto;
    height: 88vh;          /* 老浏览器回退 */
    height: 88dvh;         /* 移动端地址栏收放时不跳动 */
    border-radius: 18px 18px 0 0;
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .drawer-head { padding: 12px 12px 12px 16px; font-size: 14px; }
  .drawer-head .lbtn { width: 30px; height: 30px; }
  .panel { padding: 10px; }
  .db-cover { width: 78px; height: 110px; }
  .db-meta h3 { font-size: 15px; }
  .db-actions { flex-wrap: wrap; }
  .plist li, .cand { padding: 9px 8px; }
  .plist li .savebtn, .plist li .del { width: 30px; height: 30px; }
  .pt-cache { top: 50px; right: 10px; font-size: 11px; }

  /* 截图浮层：贴边铺开，别挡住控制条 */
  .shots { left: 8px; right: 8px; width: auto; bottom: calc(88px + env(safe-area-inset-bottom, 0px)); padding: 8px 10px; }
  .shot img { height: 60px; width: 107px; }

  /* 验证码弹层：全宽、输入框放大 */
  .cap-pop { width: calc(100vw - 32px); max-width: 360px; padding: 16px; }
  .cap-input { font-size: 16px; height: 40px; }
  .cap-actions .btn { height: 36px; padding: 0 16px; }
  .cap-img-row img { height: 46px; }
}

/* 小屏手机：再压一档尺寸，保证控制条不溢出 */
@media (max-width: 400px) {
  .cbtn { width: 38px; height: 38px; }
  .cbtn.play { width: 44px; height: 44px; }
  .bar-left, .bar-right { gap: 0; }
  .time { font-size: 10.5px; margin-left: 0; }
  .cbtn.text { padding: 0 5px; font-size: 11.5px; }
}
@media (max-width: 370px) {
  .navbtn { padding: 0 6px; }
  #btnRepeat { display: none; }
}

/* 手机横屏 / 矮屏：单行顶栏，给画面留高度 */
@media (max-height: 520px) and (orientation: landscape) {
  .topbar { height: 48px; flex-wrap: nowrap; padding: 0 10px; gap: 8px; }
  .searchbar { order: 0; flex: 1 1 auto; height: 34px; }
  .brand-text { display: none; }
  .brand-ic { width: 30px; height: 30px; }
  .layout { padding: 0 8px 8px; }
  .controls { padding: 16px 10px 4px; }
  .lyric-box { padding: 24px 0 72px; }
  .lyric-head { bottom: 74px; }
}
