/* 影音播放器 —— 前端主逻辑 */
(function () {
  'use strict';

  const $ = (s, r) => (r || document).querySelector(s);
  const $$ = (s, r) => Array.from((r || document).querySelectorAll(s));
  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));

  const SKINS = [
    { id: 'midnight', name: '极夜', c: ['#4c8dff', '#0d1117'] },
    { id: 'dawn', name: '晨光', c: ['#2563eb', '#f2f5fb'] },
    { id: 'aurora', name: '极光', c: ['#2fd4a0', '#0c1a1c'] },
    { id: 'sakura', name: '樱', c: ['#f0568a', '#fdf3f6'] },
    { id: 'ocean', name: '深海', c: ['#2ea8ff', '#061626'] },
    { id: 'amber', name: '琥珀', c: ['#f5a524', '#171208'] },
  ];

  const AUDIO_EXT = new Set(['mp3', 'm4a', 'wav', 'flac', 'aac', 'opus', 'ogg', 'oga', 'aiff', 'aif']);
  const extOf = (n) => (String(n).split('.').pop() || '').toLowerCase();

  const FORMATS = [
    ['MP4 / H.264', 'video/mp4; codecs="avc1.42E01E,mp4a.40.2"'],
    ['MP4 / H.265', 'video/mp4; codecs="hvc1.1.6.L93.B0"'],
    ['MP4 / AV1', 'video/mp4; codecs="av01.0.05M.08"'],
    ['WebM / VP9', 'video/webm; codecs="vp9"'],
    ['WebM / VP8', 'video/webm; codecs="vp8"'],
    ['Matroska MKV', 'video/x-matroska'],
    ['QuickTime MOV', 'video/quicktime'],
    ['AVI', 'video/x-msvideo'],
    ['WMV', 'video/x-ms-wmv'],
    ['MP3', 'audio/mpeg'],
    ['AAC / M4A', 'audio/mp4; codecs="mp4a.40.2"'],
    ['FLAC', 'audio/flac'],
    ['WAV', 'audio/wav'],
    ['Ogg Vorbis', 'audio/ogg; codecs="vorbis"'],
    ['Opus', 'audio/ogg; codecs="opus"'],
  ];

  /* ------------------------------ 状态 ------------------------------ */
  const state = {
    entries: [],     // {id, name, kind, url, file, path, cover, tags, parsed}
    index: -1,
    repeat: 0,       // 0 不循环 / 1 单曲 / 2 列表
    shots: [],
    subject: null,   // 豆瓣条目
    candidates: [],
    fallbackUrl: '',
    fallbackMovieUrl: '',
    fallbackMusicUrl: '',
    dbKind: 'all',   // 豆瓣检索类型：all / movie / music
    dbMsg: '',
    sites: [],       // 已启用的抓取站点
    allSites: [],    // 全部站点（含停用，用于站点管理）
    siteSel: [],     // 用户勾选的站点 id
    autoLyric: true, // 本地无歌词时自动在线补抓
    tasks: [],       // 下载任务
    lyric: { lines: [], meta: {}, source: '', raw: '', path: '' },
    libDir: '',
    skin: 'midnight',
  };

  const player = $('#player');
  const media = $('#media');
  let dragging = false;
  let lyricIdx = -1;
  let idleTimer = 0;
  let thumbTimer = 0;
  let previewVideo = null;
  let previewSrc = '';

  /* ------------------------------ 工具 ------------------------------ */
  function fmt(sec) {
    if (!isFinite(sec) || sec < 0) sec = 0;
    const h = Math.floor(sec / 3600);
    const m = Math.floor((sec % 3600) / 60);
    const s = Math.floor(sec % 60);
    const p = (n) => String(n).padStart(2, '0');
    return h > 0 ? `${h}:${p(m)}:${p(s)}` : `${p(m)}:${p(s)}`;
  }

  let toastTimer = 0;
  function toast(msg) {
    const el = $('#toast');
    el.textContent = msg;
    el.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => { el.hidden = true; }, 2000);
  }

  function isAudio() { return player.classList.contains('audio-mode'); }
  function cur() { return state.entries[state.index] || null; }

  /* ------------------------------ 换肤 ------------------------------ */
  function setSkin(id) {
    state.skin = id;
    document.documentElement.dataset.skin = id;
    $$('.skin-chip').forEach((c) => c.classList.toggle('active', c.dataset.skin === id));
    try { localStorage.setItem('mp.skin', id); } catch (e) { /* 忽略 */ }
    if (vizActive) drawViz();
  }

  function buildSkins() {
    const box = $('#skins');
    box.innerHTML = '';
    SKINS.forEach((s) => {
      const b = document.createElement('button');
      b.className = 'skin-chip';
      b.dataset.skin = s.id;
      b.title = s.name;
      b.style.background = `linear-gradient(135deg, ${s.c[0]} 0%, ${s.c[0]} 55%, ${s.c[1]} 56%, ${s.c[1]} 100%)`;
      b.addEventListener('click', () => setSkin(s.id));
      box.appendChild(b);
    });
  }

  /* ---------------------------- 文件名解析 ---------------------------- */
  const JUNK = new Set([
    '1080p', '1080i', '720p', '480p', '2160p', '4320p', '4k', '8k', 'uhd', 'hd', 'sd', 'fhd', 'fullhd',
    'bluray', 'blu-ray', 'bdrip', 'brrip', 'bd', 'dvdrip', 'dvdscr', 'dvd', 'hdrip', 'hdtv', 'hdtvrip',
    'webrip', 'web-dl', 'webdl', 'web', 'cam', 'ts', 'tc', 'r5', 'r6', 'hdr', 'hdr10', 'sdr', 'dv',
    '10bit', '8bit', '12bit', 'x264', 'x265', 'h264', 'h265', 'hevc', 'avc', 'xvid', 'divx', 'av1',
    'aac', 'ac3', 'eac3', 'dts', 'dts-hd', 'truehd', 'atmos', 'mp3', 'flac', 'opus', 'ogg', 'wav', 'm4a',
    '320k', '256k', '192k', '128k', 'kbps', 'remux', 'imax', 'proper', 'repack', 'extended', 'theatrical',
    'uncut', 'directors', 'directorscut', 'internal', 'limited', 'multilingual', 'chs', 'cht', 'gb', 'big5',
    'eng', 'english', 'chinese', '国语', '粤语', '中字', '中英', '字幕', 'subbed', 'hardcoded', 'sample',
    'amzn', 'nf', 'netflix', 'dsnp', 'hmax', 'atvp', 'hulu', 'itunes', 'max', 'pcok', '60fps', '120fps', 'fps',
    'yify', 'rarbg', 'yts', 'eztv', 'fgt', 'sparks', 'ntb', 'tgx', 'ctrls', 'cm8', 'w4f', 'd3g', 'movies',
    'movie', 'film', 'video', 'audio', 'track', 'cd1', 'cd2', 'disc1', 'disc2', 'part1', 'part2', 'ova', 'oad',
  ]);

  function cleanTokens(str) {
    return String(str)
      .replace(/[\[【(][^\]】)]*[\]】)]/g, ' ')
      .split(/[\s._+&·、]+/g)
      .map((t) => t.replace(/^-+|-+$/g, ''))
      .filter((t) => {
        if (!t) return false;
        const low = t.toLowerCase();
        if (JUNK.has(low)) return false;
        if (/^\d{3,4}[pi]$/i.test(t)) return false;
        if (/^\d+(k|kb|mb|gb|fps|hz)$/i.test(t)) return false;
        if (/^(19|20)\d{2}$/.test(t)) return false;
        if (/^\d+$/.test(t)) return false;
        if (/^(cd|disc|part|ep|s)\d+$/i.test(t)) return false;
        return true;
      });
  }

  function parseName(name) {
    const base = String(name || '').replace(/\.[A-Za-z0-9]{1,5}$/, '');
    const yearM = base.match(/(?:^|[^0-9])(19\d{2}|20\d{2})(?:[^0-9]|$)/);
    const year = yearM ? yearM[1] : '';
    let season = ''; let episode = '';
    const seM = base.match(/[Ss](\d{1,2})[\s._-]?[Ee](\d{1,3})/) || base.match(/第\s*(\d{1,3})\s*[集话]/);
    if (seM) {
      if (seM[2]) { season = seM[1]; episode = seM[2]; } else { episode = seM[1]; }
    }
    let raw = base;
    if (yearM) raw = base.slice(0, yearM.index + yearM[0].length);
    if (seM) raw = raw.slice(0, seM.index);

    let title = cleanTokens(raw).join(' ').trim();
    if (!title) title = cleanTokens(base).join(' ').trim();
    if (!title) title = base.trim();

    let artist = ''; let album = '';
    const dash = base.split(/\s+-\s+|\s+–\s+/);
    if (dash.length >= 2) {
      const a = cleanTokens(dash[0]).join(' ').trim();
      const t = cleanTokens(dash[1]).join(' ').trim();
      if (a && t) { artist = a; if (!title || title === base.trim()) title = t; }
    }
    return { title, year, season, episode, artist, album, raw: base };
  }

  /* ------------------------------ ID3 ------------------------------ */
  function decodeID3Text(u8) {
    if (!u8 || !u8.length) return '';
    const enc = u8[0];
    let data = u8.subarray(1);
    let label = 'utf-8';
    if (enc === 0) label = 'gb18030';
    else if (enc === 1) {
      if (data[0] === 0xff && data[1] === 0xfe) { label = 'utf-16le'; data = data.subarray(2); }
      else if (data[0] === 0xfe && data[1] === 0xff) { label = 'utf-16be'; data = data.subarray(2); }
      else label = 'utf-16be';
    } else if (enc === 2) label = 'utf-16be';
    try {
      return new TextDecoder(label).decode(data).replace(/\0[\s\S]*$/, '').trim();
    } catch (e) {
      try { return new TextDecoder('utf-8').decode(data).replace(/\0[\s\S]*$/, '').trim(); } catch (e2) { return ''; }
    }
  }

  function cstringLen(u8, enc) {
    if (!u8.length) return 0;
    if (enc === 1 || enc === 2) {
      for (let i = 0; i + 1 < u8.length; i++) if (u8[i] === 0 && u8[i + 1] === 0) return i + 2;
      return u8.length;
    }
    const i = u8.indexOf(0);
    return i < 0 ? u8.length : i + 1;
  }

  function synchsafe(n) {
    return ((n & 0x7f000000) >> 3) + ((n & 0x7f0000) >> 2) + ((n & 0x7f00) >> 1) + (n & 0x7f);
  }

  async function readID3(file, kind) {
    const out = { title: '', artist: '', album: '', year: '', cover: '' };
    if (!file || kind !== 'audio') return out;
    try {
      const head = new Uint8Array(await file.slice(0, 260 * 1024).arrayBuffer());
      const dv = new DataView(head.buffer);
      if (head.length > 10 && String.fromCharCode(head[0], head[1], head[2]) === 'ID3') {
        const ver = dv.getUint8(3);
        const flags = dv.getUint8(5);
        const total = synchsafe(dv.getUint32(6));
        let p = 10;
        if (flags & 0x40) {
          const es = ver === 4 ? synchsafe(dv.getUint32(p)) : dv.getUint32(p);
          p += 4 + es;
        }
        const end = Math.min(10 + total, head.length);
        while (p + 10 <= end) {
          const id = String.fromCharCode(head[p], head[p + 1], head[p + 2], head[p + 3]);
          if (!/^[A-Z0-9]{4}$/.test(id)) break;
          const fsize = ver === 4 ? synchsafe(dv.getUint32(p + 4)) : dv.getUint32(p + 4);
          if (fsize <= 0 || p + 10 + fsize > head.length) break;
          const body = head.subarray(p + 10, p + 10 + fsize);
          if (id === 'APIC' && !out.cover) {
            const enc = body[0];
            let q = 1;
            const mimeEnd = body.indexOf(0, q);
            if (mimeEnd > 0) {
              const mime = new TextDecoder('latin1').decode(body.subarray(q, mimeEnd)) || 'image/jpeg';
              q = mimeEnd + 2; // mime 结束符 + 图片类型
              q += cstringLen(body.subarray(q), enc);
              const img = body.subarray(q);
              if (img.length > 1024) {
                out.cover = URL.createObjectURL(new Blob([img], { type: mime === 'image/jpg' ? 'image/jpeg' : mime }));
              }
            }
          } else if (id === 'TIT2' && !out.title) out.title = decodeID3Text(body);
          else if (id === 'TPE1' && !out.artist) out.artist = decodeID3Text(body);
          else if (id === 'TALB' && !out.album) out.album = decodeID3Text(body);
          else if ((id === 'TYER' || id === 'TDRC') && !out.year) out.year = (decodeID3Text(body).match(/\d{4}/) || [''])[0];
          p += 10 + fsize;
        }
      }
      // ID3v1
      if (!out.title && file.size >= 128) {
        const tail = new Uint8Array(await file.slice(file.size - 128).arrayBuffer());
        if (String.fromCharCode(tail[0], tail[1], tail[2]) === 'TAG') {
          const seg = (a, b) => new TextDecoder('gb18030').decode(tail.subarray(a, b)).replace(/\0[\s\S]*$/, '').trim();
          out.title = seg(3, 33);
          out.artist = seg(33, 63);
          out.album = seg(63, 93);
          out.year = (seg(93, 97).match(/\d{4}/) || [''])[0];
        }
      }
    } catch (e) { /* 标签解析失败不影响播放 */ }
    return out;
  }

  /* ---------------------------- 文件入口 ---------------------------- */
  function addFiles(fileList) {
    try {
      const list = Array.from(fileList || []).filter((f) => {
        const e = extOf(f.name);
        return AUDIO_EXT.has(e) || /\.(mp4|m4v|webm|mkv|mov|avi|wmv|flv|ogv|mpg|mpeg|ts|3gp)$/i.test(f.name) || /^(video|audio)\//.test(f.type);
      });
      if (!list.length) { toast('没有可播放的媒体文件'); return; }
      const start = state.entries.length;
      list.forEach((f) => {
        const kind = AUDIO_EXT.has(extOf(f.name)) ? 'audio' : 'video';
        state.entries.push({
          id: 'f' + Date.now() + Math.random().toString(36).slice(2, 7),
          name: f.name,
          path: f.webkitRelativePath || f.name,
          kind,
          file: f,
          url: URL.createObjectURL(f),
          tags: null,
          parsed: parseName(f.name),
        });
      });
      afterAdd(start);
      toast(`已添加 ${list.length} 个文件`);
    } catch (err) {
      console.error(err);
      toast('添加文件失败：' + err.message);
    }
  }

  // 从服务端路径导入（资源导入面板里的「已下载」列表用）
  function addServerFiles(paths) {
    const start = state.entries.length;
    paths.forEach((p) => {
      const kind = AUDIO_EXT.has(extOf(p)) ? 'audio' : 'video';
      state.entries.push({
        id: 's' + Date.now() + Math.random().toString(36).slice(2, 7),
        name: p.split(/[\\/]/).pop(),
        path: p,
        kind,
        file: null,
        url: '/api/stream?file=' + encodeURIComponent(p),
        tags: null,
        parsed: parseName(p.split(/[\\/]/).pop()),
      });
    });
    afterAdd(start);
  }

  // 资源导入面板：列出下载目录里已有的文件，点一下即加入播放列表
  async function loadImportList() {
    const ul = $('#ipList');
    if (!ul) return;
    ul.innerHTML = '<li class="ip-empty">读取中…</li>';
    try {
      const data = await apiJSON('/api/browse?dir=@downloads');
      if (!data.ok) { ul.innerHTML = `<li class="ip-empty">${escapeHtml(data.error || '读取失败')}</li>`; return; }
      if (data.dir) $('#ipDir').textContent = 'downloads';
      const files = (data.files || []).slice().sort((a, b) => (b.mtime || 0) - (a.mtime || 0));
      ul.innerHTML = '';
      if (!files.length) { ul.innerHTML = '<li class="ip-empty">下载目录还是空的</li>'; return; }
      files.slice(0, 50).forEach((f) => {
        const li = document.createElement('li');
        const audio = AUDIO_EXT.has(extOf(f.name));
        li.innerHTML = `<svg class="ic" viewBox="0 0 24 24"><use href="#i-${audio ? 'music' : 'film'}"/></svg>`
          + `<span class="nm" title="${escapeHtml(f.name)}">${escapeHtml(f.name)}</span>`
          + `<span class="sz">${(f.size / 1048576).toFixed(1)} MB</span>`;
        li.addEventListener('click', () => {
          addServerFiles([f.path]);
          $('#importPop').hidden = true;
          toast('已导入：' + f.name);
        });
        ul.appendChild(li);
      });
    } catch (err) {
      ul.innerHTML = '<li class="ip-empty">无法连接本地服务</li>';
    }
  }

  function afterAdd(start) {
    addAll();
    renderList();
    // 始终跳到本次新加入的第一个文件，避免「选了文件却没反应」
    loadEntry(start, true);
  }

  function addAll() {
    const pending = state.entries.filter((e) => e.kind === 'audio' && e.file && !e.tags);
    if (!pending.length) return;
    Promise.all(pending.map(async (e) => {
      e.tags = await readID3(e.file, 'audio');
      if (e.tags.cover) e.cover = e.tags.cover;
      if (e.tags.title) e.parsed.title = e.tags.title;
    })).then(() => {
      renderList();
      if (cur() && cur().kind === 'audio') { renderInfo(); updateAudioStage(); }
    });
  }

  async function loadEntry(i, autoplay) {
    const e = state.entries[i];
    if (!e) return;
    state.index = i;
    state.subject = e.info || null;   // 站点抓来的信息优先，不被自动匹配冲掉
    media.src = e.url;
    media.load();
    syncPlayUI();
    player.classList.add('has-media');
    player.classList.toggle('audio-mode', e.kind === 'audio');
    $('#ptTitle').textContent = e.name;
    $('#ptBadge').hidden = true;
    $('#dropHint').hidden = true;
    $('#centerPlay').hidden = !!autoplay;
    $('#dbQuery').value = '';
    $('#dbCands').innerHTML = '';
    if (!e.tags && e.kind === 'audio' && e.file) { e.tags = await readID3(e.file, 'audio'); if (e.tags.cover) e.cover = e.tags.cover; }
    previewSrc = '';
    updateAudioStage();
    renderList();
    renderInfo();
    if (e.lyric) setLyric(e.lyric, e.lyricSrc || '站点歌词', '');
    else ensureLyric(e);
    if (autoplay) play().catch(() => { /* 需要用户手势 */ });
    if (!e.info) autoFetch();
  }

  function updateAudioStage() {
    const e = cur();
    const img = $('#discImg');
    const src = (e && (e.cover || (e.tags && e.tags.cover))) || '';
    if (src) { img.src = src; img.hidden = false; } else { img.removeAttribute('src'); img.hidden = true; }
    $('#audioTitle').textContent = e ? (e.tags && e.tags.title ? `${e.tags.title} - ${e.tags.artist || ''}`.replace(/ - $/, '') : e.parsed.title || e.name) : '';
  }

  /* ---------------------------- 播放控制 ---------------------------- */
  function play() {
    const p = media.play();
    if (p && p.catch) p.catch(() => { $('#centerPlay').hidden = false; });
    return p;
  }

  function toggle() {
    if (!state.entries.length) {
      toast('列表是空的：点左上角「打开」添加本地文件，或在右侧搜索后点选站点结果在线播放');
      return;
    }
    if (media.paused) { $('#centerPlay').hidden = true; play(); } else { media.pause(); $('#centerPlay').hidden = false; }
    syncPlayUI();
  }

  // 播放/暂停图标随状态切换
  function syncPlayUI() {
    const playing = !media.paused && !media.ended && !!media.src;
    const btn = $('#btnPlay');
    btn.innerHTML = `<svg class="ic" viewBox="0 0 24 24"><use href="#${playing ? 'i-pause' : 'i-play'}"/></svg>`;
    btn.title = `${playing ? '暂停' : '播放'} (空格)`;
    btn.classList.toggle('is-playing', playing);
    player.classList.toggle('playing', playing);
    if (playing) player.classList.remove('idle');
  }

  function step(n) {
    if (!state.entries.length) return;
    if (state.repeat === 1) { media.currentTime = 0; play(); return; }
    let i = state.index + n;
    if (state.repeat === 2) i = (i + state.entries.length) % state.entries.length;
    if (i < 0 || i >= state.entries.length) { media.pause(); toast(n > 0 ? '已到列表末尾' : '已到列表开头'); return; }
    loadEntry(i, true);
  }

  function setRate(r, quiet) {
    r = clamp(Number(r) || 1, 0.25, 4);
    media.playbackRate = r;
    $('#btnSpeed').innerHTML = r.toFixed(2).replace(/0$/, '') + '<em>×</em>';
    $('#speedRange').value = r;
    paintRange($('#speedRange'));
    $$('#speedChips button').forEach((b) => b.classList.toggle('active', Math.abs(Number(b.dataset.r) - r) < 0.001));
    try { localStorage.setItem('mp.rate', r); } catch (e) { /* 忽略 */ }
    if (!quiet) toast(`倍速 ${r.toFixed(2).replace(/0$/, '')}×`);
  }

  // 把滑杆当前值换算成 0~1 写入 --v，供 CSS 绘制已填充部分
  function paintRange(el) {
    if (!el) return;
    const min = Number(el.min || 0);
    const max = Number(el.max || 1);
    const v = Number(el.value);
    const r = max > min ? (v - min) / (max - min) : 0;
    el.style.setProperty('--v', String(Math.min(1, Math.max(0, r))));
  }

  function setVolume(v, quiet) {
    v = clamp(Number(v), 0, 1);
    media.volume = v;
    media.muted = v === 0;
    $('#vol').value = v;
    paintRange($('#vol'));
    $('#btnMute').innerHTML = `<svg class="ic" viewBox="0 0 24 24"><use href="#i-${v === 0 ? 'mute' : 'vol'}"/></svg>`;
    try { localStorage.setItem('mp.vol', v); } catch (e) { /* 忽略 */ }
    if (!quiet) toast(`音量 ${Math.round(v * 100)}%`);
  }

  async function toggleFull() {
    try {
      if (document.fullscreenElement || document.webkitFullscreenElement) {
        await (document.exitFullscreen ? document.exitFullscreen() : document.webkitExitFullscreen());
      } else if (player.requestFullscreen) {
        await player.requestFullscreen();
      } else if (player.webkitRequestFullscreen) {
        player.webkitRequestFullscreen();
      }
    } catch (e) { toast('当前环境不支持全屏'); }
  }

  async function togglePip() {
    try {
      if (document.pictureInPictureElement) await document.exitPictureInPicture();
      else if (media.requestPictureInPicture) await media.requestPictureInPicture();
      else toast('当前浏览器不支持画中画');
    } catch (e) { toast('画中画不可用'); }
  }

  /* ------------------------------ 截图 ------------------------------ */
  const coverImg = new Image();

  function loadImg(src) {
    return new Promise((resolve) => {
      if (!src) return resolve(false);
      if (coverImg.src === src && coverImg.complete) return resolve(!!coverImg.naturalWidth);
      coverImg.onload = () => resolve(true);
      coverImg.onerror = () => resolve(false);
      coverImg.src = src;
    });
  }

  function drawAudioCard(c, ctx, coverOK) {
    const W = 960; const H = 540;
    c.width = W; c.height = H;
    const e = cur();
    const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#4c8dff';
    const g = ctx.createLinearGradient(0, 0, W, H);
    g.addColorStop(0, '#11161d');
    g.addColorStop(1, '#05080c');
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
    ctx.fillStyle = accent; ctx.globalAlpha = 0.12;
    ctx.beginPath(); ctx.arc(W - 120, 120, 260, 0, Math.PI * 2); ctx.fill(); ctx.globalAlpha = 1;

    const size = 280; const cx = 240; const cy = H / 2; const r = size / 2;
    ctx.save();
    ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2); ctx.clip();
    if (coverOK && coverImg.naturalWidth) {
      ctx.drawImage(coverImg, cx - r, cy - r, size, size);
    } else {
      ctx.fillStyle = '#1c2430'; ctx.fillRect(cx - r, cy - r, size, size);
      ctx.strokeStyle = 'rgba(255,255,255,.07)'; ctx.lineWidth = 2;
      for (let i = 1; i <= 4; i++) {
        ctx.beginPath(); ctx.arc(cx, cy, (r * i) / 5, 0, Math.PI * 2); ctx.stroke();
      }
    }
    ctx.restore();
    ctx.strokeStyle = 'rgba(255,255,255,.15)'; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2); ctx.stroke();
    ctx.fillStyle = '#05080c';
    ctx.beginPath(); ctx.arc(cx, cy, 24, 0, Math.PI * 2); ctx.fill();

    const title = (e && e.tags && e.tags.title) || (e && e.parsed.title) || '未知音轨';
    const artist = (e && e.tags && e.tags.artist) || (e && e.parsed.artist) || '';
    const album = (e && e.tags && e.tags.album) || '';
    ctx.textBaseline = 'top';
    ctx.fillStyle = '#fff';
    ctx.font = '600 46px "Microsoft YaHei", sans-serif';
    wrapText(ctx, title, cx + size / 2 + 40, 150, 380, 56);
    ctx.fillStyle = 'rgba(255,255,255,.7)';
    ctx.font = '28px "Microsoft YaHei", sans-serif';
    if (artist) ctx.fillText(artist, cx + size / 2 + 40, 240);
    if (album) ctx.fillText(album, cx + size / 2 + 40, 284);

    const y = H - 96; const w = W - 160;
    ctx.fillStyle = 'rgba(255,255,255,.18)'; ctx.fillRect(80, y, w, 8);
    ctx.fillStyle = accent;
    const p = media.duration ? media.currentTime / media.duration : 0;
    ctx.fillRect(80, y, w * clamp(p, 0, 1), 8);
    ctx.fillStyle = 'rgba(255,255,255,.65)';
    ctx.font = '22px Consolas, monospace';
    ctx.fillText(`${fmt(media.currentTime)} / ${fmt(media.duration)}`, 80, y + 24);
  }

  function wrapText(ctx, text, x, y, maxW, lh) {
    let line = ''; let ty = y;
    for (const ch of String(text)) {
      const test = line + ch;
      if (ctx.measureText(test).width > maxW && line) {
        ctx.fillText(line, x, ty); line = ch; ty += lh;
      } else line = test;
    }
    if (line) ctx.fillText(line, x, ty);
  }

  async function capture() {
    const e = cur();
    if (!e) { toast('请先载入媒体文件'); return; }
    const c = document.createElement('canvas');
    const ctx = c.getContext('2d');
    if (e.kind === 'audio') {
      const cover = e.cover || (e.tags && e.tags.cover) || (state.subject && proxiedCover(state.subject.cover)) || '';
      drawAudioCard(c, ctx, await loadImg(cover));
    } else {
      if (!media.videoWidth) { toast('视频尚未就绪'); return; }
      c.width = media.videoWidth;
      c.height = media.videoHeight;
      try { ctx.drawImage(media, 0, 0, c.width, c.height); } catch (err) { toast('无法截取该画面'); return; }
    }
    const stamp = `${e.name.replace(/\.[^.]+$/, '')}_${fmt(media.currentTime).replace(/:/g, '')}.png`;
    c.toBlob((blob) => {
      if (!blob) { toast('截图失败'); return; }
      const url = URL.createObjectURL(blob);
      state.shots.unshift({ url, blob, name: stamp });
      if (state.shots.length > 24) {
        const old = state.shots.pop();
        URL.revokeObjectURL(old.url);
      }
      renderShots();
      toast('已截图：' + stamp);
    }, 'image/png');
  }

