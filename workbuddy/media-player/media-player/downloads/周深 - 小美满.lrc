                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body p-4">
                <p class="text-muted font-smaller mb-4">您的建议是我们进步的动力<b class="text-muted">（如需提交截图信息请登录后进行提交）</b>。</p>

                <div class="form-group mb-3">
                    <label for="feedbackType" class="font-weight-bold small text-secondary">反馈类型</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-light border-right-0"><i
                                        class="fa fa-list-ul text-secondary"></i></span>
                        </div>
                        <select class="form-control border-left-0 focus-shadow" id="feedbackType" required>
                            <option value="" selected disabled>请选择反馈类型</option>
                            <option value="function">功能建议（网站功能改进建议）</option>
                            <option value="music">歌曲收录（请提供歌手和歌名）</option>
                            <option value="other">其他</option>
                        </select>
                    </div>
                </div>

                <div class="form-group mb-3" id="link-group" style="display: none">
                    <label for="link" class="font-weight-bold small text-secondary">错误链接</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-light border-right-0"><i
                                        class="fa fa-link text-secondary"></i></span>
                        </div>
                        <input type="text" class="form-control border-left-0 focus-shadow" placeholder="请输入出错的网址链接"
                               id="link">
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label for="feedbackContent" class="font-weight-bold small text-secondary">反馈内容</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-light border-right-0"
                                  style="align-items: flex-start; padding-top: 0.7rem;"><i
                                        class="fa fa-pencil text-secondary"></i></span>
                        </div>
                        <textarea class="form-control border-left-0 focus-shadow" id="feedbackContent" rows="4" required
                                  placeholder="请详细描述您遇到的问题或建议..."
                                  style="resize: none;"></textarea>
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label for="feedbackContact" class="font-weight-bold small text-secondary">联系邮箱</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-light border-right-0"><i
                                        class="fa fa-envelope-o text-secondary"></i></span>
                        </div>
                        <input type="email" class="form-control border-left-0 focus-shadow" id="feedbackContact"
                               placeholder="example@email.com" required>
