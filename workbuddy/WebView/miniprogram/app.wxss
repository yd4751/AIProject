page {
    min-height: 100%;
    background: #f5f7fa;
    color: #1f2329;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

button {
    border-radius: 12rpx;
}

/* 通用卡片 */
.card {
    box-sizing: border-box;
    padding: 32rpx;
    border: 2rpx solid #e5e8eb;
    border-radius: 24rpx;
    background: #ffffff;
}

/* 通用状态徽标 */
.status-dot {
    display: inline-block;
    width: 16rpx;
    height: 16rpx;
    border-radius: 50%;
    background: #c9cdd4;
}

.status-dot.ok {
    background: #18a058;
}

.status-dot.warn {
    background: #f59e0b;
}

.status-dot.bad {
    background: #d4380d;
}

/* 通用按压反馈 */
.pressed {
    opacity: 0.72;
    transform: scale(0.985);
}
