.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 20rpx 24rpx 300rpx;
}

/* 顶部站点条 */
.site-bar {
    display: flex;
    align-items: center;
    padding: 20rpx 24rpx;
    margin-bottom: 20rpx;
    border: 2rpx solid #e5e8eb;
    border-radius: 20rpx;
    background: #ffffff;
}

.site-bar-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.site-bar-host {
    color: #1769e0;
    font-size: 21rpx;
    font-weight: 600;
    letter-spacing: 1rpx;
}

.site-bar-title {
    margin-top: 6rpx;
    color: #1f2329;
    font-size: 28rpx;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.site-bar-badge {
    flex-shrink: 0;
    margin-left: 16rpx;
    padding: 6rpx 18rpx;
    border-radius: 999rpx;
    background: #eaf2ff;
    color: #1769e0;
    font-size: 21rpx;
}

/* 骨架屏 */
.skeleton { padding: 20rpx 4rpx; }
.skeleton-title,
.skeleton-line,
.skeleton-card {
    border-radius: 12rpx;
    background: linear-gradient(90deg, #eef1f4 25%, #f7f9fb 45%, #eef1f4 65%);
    background-size: 400% 100%;
    animation: skeleton-wave 1.4s ease infinite;
}
.skeleton-title { width: 62%; height: 48rpx; margin-bottom: 30rpx; }
.skeleton-line { height: 26rpx; margin-bottom: 20rpx; }
.w90 { width: 90%; }
.w80 { width: 80%; }
.w70 { width: 70%; }
.w60 { width: 60%; }
.skeleton-gap { height: 40rpx; }
.skeleton-cards { display: flex; }
.skeleton-card { width: 47%; height: 260rpx; margin-right: 20rpx; }
.skeleton-loading { margin-top: 36rpx; text-align: center; color: #8f959e; font-size: 24rpx; }
@keyframes skeleton-wave {
    0% { background-position: 100% 0; }
    100% { background-position: 0 0; }
}

/* 错误态 */
.state-card {
    box-sizing: border-box;
    padding: 36rpx;
    border: 2rpx solid #e5e8eb;
    border-radius: 24rpx;
    background: #ffffff;
    display: flex;
    min-height: 320rpx;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    text-align: center;
}
.state-card-error { border-color: #ffd8d6; }
.state-icon { color: #d4380d; font-size: 56rpx; font-weight: 700; }
.state-title { margin-top: 20rpx; font-size: 34rpx; font-weight: 600; }
.state-description { margin-top: 12rpx; color: #646a73; font-size: 26rpx; line-height: 1.6; }
.error-actions { display: flex; flex-wrap: wrap; justify-content: center; margin-top: 28rpx; }
.ghost-button { margin-right: 16rpx; background: #f2f3f5; color: #1f2329; font-size: 26rpx; }
.primary-button { background: #1769e0; color: #ffffff; font-size: 26rpx; }
.diagnosis { box-sizing: border-box; width: 100%; margin-top: 28rpx; padding: 24rpx; border-radius: 20rpx; background: #fff9f0; text-align: left; }
.diagnosis-head { display: flex; flex-direction: column; margin-bottom: 14rpx; }
.diagnosis-title { font-size: 26rpx; font-weight: 600; color: #a35a00; }
.diagnosis-mode { margin-top: 6rpx; font-size: 21rpx; color: #b07b3e; }
.diagnosis-item { display: flex; margin-top: 12rpx; }
.diagnosis-dot { margin-right: 10rpx; color: #a35a00; font-size: 24rpx; }
.diagnosis-text { flex: 1; color: #6b4a20; font-size: 23rpx; line-height: 1.6; }
.diagnosis-url { display: block; margin-top: 20rpx; color: #9b8468; font-size: 21rpx; word-break: break-all; }

/* 离线快照横幅 */
.snapshot-banner { margin-bottom: 20rpx; padding: 20rpx 24rpx; border: 2rpx solid #ffe7ba; border-radius: 20rpx; background: #fff9ec; }
.snapshot-row { display: flex; align-items: center; }
.snapshot-tag { padding: 3rpx 14rpx; border-radius: 999rpx; background: #fa8c16; color: #fff; font-size: 20rpx; font-weight: 600; flex-shrink: 0; }
.snapshot-note { margin-left: 14rpx; color: #8a5a00; font-size: 23rpx; flex: 1; }
.snapshot-toggle { margin-left: 12rpx; color: #1769e0; font-size: 23rpx; flex-shrink: 0; }
.snapshot-detail { margin-top: 18rpx; padding-top: 18rpx; border-top: 2rpx solid #ffe7ba; }
.snapshot-error { display: block; margin-bottom: 10rpx; color: #ad4e00; font-size: 23rpx; font-weight: 600; }
.snapshot-reason { display: block; margin-bottom: 8rpx; color: #8a5a00; font-size: 22rpx; line-height: 1.6; }
.snapshot-actions { display: flex; margin-top: 16rpx; }

/* 切换栏 */
.mode-switch,
.view-switch {
    display: flex;
    padding: 6rpx;
    margin-bottom: 20rpx;
    border-radius: 16rpx;
    background: #eaeef3;
}
.mode-item,
.view-item {
    flex: 1;
    text-align: center;
    padding: 16rpx 0;
    border-radius: 12rpx;
    color: #646a73;
    font-size: 26rpx;
}
.mode-item.active,
.view-item.active {
    background: #ffffff;
    color: #1769e0;
    font-weight: 600;
    box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, 0.08);
}

/* 应用加速模式 */
.app-head {
    display: flex;
    align-items: center;
    padding: 28rpx;
    border-radius: 24rpx;
    background: #0d1117;
}
.app-logo {
    width: 88rpx;
    height: 88rpx;
    border-radius: 24rpx;
    background: #1769e0;
    color: #ffffff;
    font-size: 40rpx;
    font-weight: 700;
    line-height: 88rpx;
    text-align: center;
}
.app-head-text { flex: 1; min-width: 0; margin-left: 22rpx; display: flex; flex-direction: column; }
.app-name { color: #ffffff; font-size: 32rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.app-status { margin-top: 8rpx; color: #9aa7b8; font-size: 22rpx; }
.app-refresh { width: 64rpx; height: 64rpx; border-radius: 999rpx; background: rgba(255,255,255,0.1); color: #ffffff; font-size: 36rpx; line-height: 64rpx; text-align: center; }

.app-tabs { display: flex; margin: 24rpx 0 8rpx; }
.app-tab { flex: 1; text-align: center; padding: 16rpx 0; color: #8f959e; font-size: 27rpx; border-bottom: 4rpx solid transparent; }
.app-tab.active { color: #1769e0; font-weight: 600; border-bottom-color: #1769e0; }
.app-panel { padding-top: 16rpx; }
.app-section-title { display: flex; align-items: center; margin: 24rpx 4rpx 14rpx; color: #1f2329; font-size: 28rpx; font-weight: 600; }
.app-section-count { margin-left: auto; color: #8f959e; font-size: 23rpx; font-weight: 400; }

.track-row,
.site-row,
.task-row {
    display: flex;
    align-items: center;
    padding: 20rpx 22rpx;
    margin-bottom: 14rpx;
    border: 2rpx solid #e5e8eb;
    border-radius: 20rpx;
    background: #ffffff;
}
.track-cover {
    width: 84rpx;
    height: 84rpx;
    flex-shrink: 0;
    border-radius: 16rpx;
    overflow: hidden;
    background: #eef2f7;
    display: flex;
    align-items: center;
    justify-content: center;
}
.track-cover image { width: 84rpx; height: 84rpx; }
.track-cover-text { color: #8f959e; font-size: 22rpx; }
.track-info { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.track-title { color: #1f2329; font-size: 28rpx; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.track-sub { margin-top: 8rpx; color: #8f959e; font-size: 22rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.track-action { margin-left: 16rpx; color: #1769e0; font-size: 26rpx; flex-shrink: 0; }
.track-download { margin-left: 12rpx; padding: 8rpx 16rpx; border-radius: 999rpx; background: #eaf2ff; color: #1769e0; font-size: 21rpx; flex-shrink: 0; }

.search-bar { display: flex; align-items: center; padding: 10rpx 12rpx 10rpx 24rpx; border: 2rpx solid #e5e8eb; border-radius: 999rpx; background: #ffffff; }
.search-input { flex: 1; min-width: 0; height: 64rpx; font-size: 27rpx; color: #1f2329; }
.search-clear { padding: 0 16rpx; color: #b0b6bf; font-size: 34rpx; }
.search-go { padding: 14rpx 28rpx; border-radius: 999rpx; background: #1769e0; color: #ffffff; font-size: 25rpx; }
.filter-row { display: flex; align-items: center; flex-wrap: wrap; margin-top: 20rpx; }
.kind-chip, .site-filter { padding: 10rpx 24rpx; margin: 0 14rpx 10rpx 0; border-radius: 999rpx; background: #eef1f4; color: #646a73; font-size: 23rpx; }
.kind-chip.active { background: #1769e0; color: #ffffff; }
.site-filter { background: #fff2e0; color: #a35a00; }
.search-hint { margin: 16rpx 4rpx; color: #646a73; font-size: 23rpx; }
.search-loading { padding: 30rpx; text-align: center; color: #8f959e; font-size: 24rpx; }
.group-error { padding: 16rpx 20rpx; margin-bottom: 12rpx; border-radius: 14rpx; background: #fff1f0; color: #a32d2d; font-size: 22rpx; }

.site-kind { width: 72rpx; height: 72rpx; flex-shrink: 0; border-radius: 18rpx; background: #eaf2ff; color: #1769e0; font-size: 22rpx; line-height: 72rpx; text-align: center; }
.site-kind.movie { background: #f3ecff; color: #6d47c9; }
.site-info { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.site-name { color: #1f2329; font-size: 27rpx; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.site-sub { margin-top: 8rpx; color: #8f959e; font-size: 22rpx; }
.site-arrow { color: #b0b6bf; font-size: 34rpx; }
.app-note, .app-error { margin: 24rpx 4rpx; padding: 20rpx 24rpx; border-radius: 16rpx; background: #f2f6fc; color: #5c6b80; font-size: 22rpx; line-height: 1.7; }
.app-error { background: #fff1f0; color: #a32d2d; }

.task-row { display: block; }
.task-head { display: flex; align-items: center; }
.task-title { flex: 1; color: #1f2329; font-size: 27rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.task-status { color: #1769e0; font-size: 22rpx; }
.task-sub { display: block; margin-top: 8rpx; color: #8f959e; font-size: 22rpx; }
.task-bar { height: 10rpx; margin-top: 16rpx; border-radius: 999rpx; background: #eef1f4; overflow: hidden; }
.task-bar-inner { height: 100%; border-radius: 999rpx; background: #1769e0; }
.app-refresh-btn { margin: 24rpx 0; padding: 20rpx; border-radius: 16rpx; background: #ffffff; border: 2rpx solid #e5e8eb; color: #1769e0; font-size: 25rpx; text-align: center; }

.app-empty, .web-empty { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 70rpx 30rpx; border: 2rpx dashed #dfe4ea; border-radius: 24rpx; background: #ffffff; }
.app-empty-title, .web-empty-title { font-size: 28rpx; font-weight: 600; color: #1f2329; }
.app-empty-desc, .web-empty-desc { margin-top: 12rpx; font-size: 23rpx; color: #8f959e; line-height: 1.6; }
.web-empty-icon { color: #b0b6bf; font-size: 56rpx; margin-bottom: 16rpx; }

/* 通用网页浏览 */
.content-tip { display: flex; align-items: flex-start; padding: 20rpx 24rpx; margin-bottom: 20rpx; border-radius: 18rpx; background: #fff8e8; border: 2rpx solid #ffe7ba; }
.content-tip-text { flex: 1; color: #8a5a00; font-size: 22rpx; line-height: 1.6; }
.content-tip-action { margin-left: 16rpx; color: #1769e0; font-size: 22rpx; flex-shrink: 0; }

.hero-wrap { width: 100%; height: 300rpx; border-radius: 24rpx; overflow: hidden; background: #eef1f4; margin-bottom: 20rpx; }
.hero-image { width: 100%; height: 300rpx; }
.web-head { padding: 28rpx 30rpx; border: 2rpx solid #e5e8eb; border-radius: 24rpx; background: #ffffff; }
.web-host { display: block; color: #1769e0; font-size: 22rpx; font-weight: 600; }
.web-title { display: block; margin-top: 12rpx; color: #1f2329; font-size: 38rpx; font-weight: 700; line-height: 1.35; }
.web-desc { display: block; margin-top: 14rpx; color: #646a73; font-size: 25rpx; line-height: 1.7; }

.nav-scroll { white-space: nowrap; margin: 24rpx 0 4rpx; }
.nav-chip { display: inline-block; padding: 14rpx 28rpx; margin-right: 14rpx; border-radius: 999rpx; background: #ffffff; border: 2rpx solid #e5e8eb; color: #3b4048; font-size: 24rpx; }
.section-title { display: flex; align-items: center; margin: 32rpx 4rpx 16rpx; color: #1f2329; font-size: 28rpx; font-weight: 600; }
.section-count { margin-left: auto; color: #8f959e; font-size: 23rpx; font-weight: 400; }
.card-grid { display: flex; flex-wrap: wrap; }
.content-card { box-sizing: border-box; width: 48.5%; margin-bottom: 20rpx; border: 2rpx solid #e5e8eb; border-radius: 20rpx; background: #ffffff; overflow: hidden; }
.content-card:nth-child(odd) { margin-right: 3%; }
.content-card-image { width: 100%; height: 200rpx; display: block; background: #eef1f4; }
.content-card-body { padding: 18rpx 20rpx 22rpx; display: flex; flex-direction: column; }
.content-card-title { color: #1f2329; font-size: 26rpx; font-weight: 600; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.content-card-desc { margin-top: 8rpx; color: #8f959e; font-size: 21rpx; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.item-list { border: 2rpx solid #e5e8eb; border-radius: 20rpx; background: #ffffff; overflow: hidden; }
.list-row { display: flex; align-items: center; padding: 24rpx 26rpx; border-bottom: 2rpx solid #f0f1f2; }
.list-row:last-child { border-bottom: 0; }
.list-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #1769e0; flex-shrink: 0; margin-right: 18rpx; }
.list-text { flex: 1; min-width: 0; color: #1f2329; font-size: 27rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.list-arrow { margin-left: 16rpx; color: #b0b6bf; font-size: 34rpx; }

.page-render { padding: 26rpx; border: 2rpx solid #e5e8eb; border-radius: 24rpx; background: #ffffff; }
.rich-content { color: #2b3038; font-size: 27rpx; line-height: 1.8; word-break: break-all; }
.render-note { margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx solid #f0f1f2; color: #9aa2ac; font-size: 21rpx; line-height: 1.7; }

.reader-body { padding: 30rpx; border: 2rpx solid #e5e8eb; border-radius: 24rpx; background: #ffffff; }
.font-small .block-text { font-size: 26rpx; }
.font-medium .block-text { font-size: 30rpx; }
.font-large .block-text { font-size: 34rpx; }
.font-small .block-heading { font-size: 32rpx; }
.font-medium .block-heading { font-size: 36rpx; }
.font-large .block-heading { font-size: 40rpx; }
.block-heading { display: block; margin: 34rpx 0 14rpx; font-weight: 700; color: #1f2329; line-height: 1.4; }
.block-heading:first-child { margin-top: 0; }
.block-heading-small { font-size: 30rpx; font-weight: 600; }
.block-text { display: block; margin-bottom: 24rpx; color: #3b4048; line-height: 1.85; }
.block-image-wrap { margin: 10rpx 0 30rpx; border-radius: 16rpx; overflow: hidden; background: #f5f7fa; }
.block-image { width: 100%; display: block; }

/* mini player */
.mini-player {
    position: fixed;
    left: 24rpx;
    right: 24rpx;
    bottom: 130rpx;
    z-index: 20;
    display: flex;
    align-items: center;
    padding: 14rpx 18rpx;
    border-radius: 20rpx;
    background: #1f2329;
    box-shadow: 0 10rpx 28rpx rgba(31, 35, 41, 0.24);
}
.mini-cover { width: 72rpx; height: 72rpx; border-radius: 14rpx; flex-shrink: 0; background: #3b4048; }
.mini-cover-empty { color: #ffffff; font-size: 28rpx; line-height: 72rpx; text-align: center; }
.mini-info { flex: 1; min-width: 0; margin-left: 18rpx; display: flex; flex-direction: column; }
.mini-title { color: #ffffff; font-size: 26rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mini-sub { margin-top: 6rpx; color: #a9b1bd; font-size: 21rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mini-progress { position: absolute; left: 18rpx; right: 18rpx; bottom: 4rpx; height: 4rpx; border-radius: 999rpx; background: rgba(255,255,255,0.16); overflow: hidden; }
.mini-progress-inner { height: 100%; background: #4f9bff; }
.mini-toggle, .mini-next { color: #ffffff; font-size: 28rpx; padding: 12rpx 14rpx; flex-shrink: 0; }
.mini-next { font-size: 22rpx; }

/* 底部工具条 */
.toolbar {
    position: fixed;
    left: 50%;
    bottom: 28rpx;
    z-index: 21;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    padding: 12rpx 18rpx;
    border-radius: 999rpx;
    background: rgba(31, 35, 41, 0.9);
    box-shadow: 0 10rpx 28rpx rgba(31, 35, 41, 0.24);
}
.tool-item { display: flex; flex-direction: column; align-items: center; padding: 6rpx 32rpx; }
.tool-icon { color: #ffffff; font-size: 30rpx; line-height: 1.2; }
.tool-text { margin-top: 4rpx; color: rgba(255,255,255,0.78); font-size: 20rpx; }

/* 播放弹层 */
.sheet-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 40; background: rgba(15, 20, 28, 0.62); display: flex; align-items: flex-end; }
.sheet { box-sizing: border-box; width: 100%; padding: 24rpx 40rpx 60rpx; border-radius: 36rpx 36rpx 0 0; background: #ffffff; display: flex; flex-direction: column; align-items: center; }
.sheet-handle { width: 72rpx; height: 8rpx; border-radius: 999rpx; background: #dfe4ea; margin-bottom: 30rpx; }
.sheet-title { color: #1f2329; font-size: 34rpx; font-weight: 600; }
.sheet-artist { margin-top: 8rpx; color: #8f959e; font-size: 24rpx; }
.sheet-cover { width: 320rpx; height: 320rpx; margin: 32rpx 0; border-radius: 28rpx; background: #eef2f7; }
.sheet-cover-empty { color: #b0b6bf; font-size: 80rpx; line-height: 320rpx; text-align: center; }
.sheet-video { width: 100%; height: 380rpx; margin: 28rpx 0; border-radius: 20rpx; background: #0d1117; }
.sheet-lyric { min-height: 48rpx; color: #3b4048; font-size: 25rpx; line-height: 1.6; text-align: center; }
.sheet-error { margin-top: 12rpx; padding: 12rpx 20rpx; border-radius: 12rpx; background: #fff1f0; color: #a32d2d; font-size: 22rpx; text-align: center; }
.sheet-slider { width: 100%; margin: 20rpx 0 0; }
.sheet-time { align-self: flex-end; color: #8f959e; font-size: 21rpx; }
.sheet-controls { display: flex; align-items: center; justify-content: space-between; width: 100%; margin-top: 26rpx; }
.sheet-btn { color: #3b4048; font-size: 30rpx; padding: 14rpx 16rpx; }
.sheet-btn.main { width: 96rpx; height: 96rpx; line-height: 96rpx; text-align: center; border-radius: 999rpx; background: #1769e0; color: #ffffff; font-size: 34rpx; }
.sheet-btn.small { color: #646a73; font-size: 22rpx; }
